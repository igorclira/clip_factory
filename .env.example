# Copy this file to .env and fill in your keys (never commit .env)

# Required — Google AI Studio (Gemini API for multimodal video+audio analysis)
GEMINI_API_KEY=

# Required for V1 Scout — Twitch Helix API (https://dev.twitch.tv/console)
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# Required for V1 Scout — Apify API Token (TikTok + X Actors: https://console.apify.com)
APIFY_TOKEN=

# Optional for V2 Scout — YouTube Data API v3 (same Google Cloud project as Gemini)
YOUTUBE_API_KEY=

# Optional — Reddit OAuth (public JSON works for low volume; OAuth recommended for reliability)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=clip_factory/0.1
